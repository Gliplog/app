{
  "name": "gliplog",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Private, offline GLP-1 journal for doses, weight and BMI (installable PWA).",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests e2e scripts build --max-warnings 0",
    "lint:fix": "eslint src tests e2e scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:md": "node scripts/check-markdown.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "icons": "pwa-assets-generator",
    "icons:android": "node scripts/android-icons.mjs",
    "screenshots:site": "vite build && node scripts/site-screenshots.mjs",
    "build:android": "vite build --mode android && cap sync android",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:static": "npm run lint && npm run format:check && npm run typecheck && npm run check:tokens && npm run check:contrast && npm run check:md && npm run knip",
    "check": "npm run check:static && npm run test && npm run build",
    "check:all": "npm run check && npm run test:e2e && npm audit --audit-level=low"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mdi/js": "7.4.47",
    "@vue/devtools-api": "8.2.1",
    "dexie": "4.4.7",
    "echarts": "6.1.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-echarts": "8.3.2",
    "vue-router": "5.4.0",
    "vuetify": "4.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "ajv": "8.20.0",
    "deepmerge": "file:vendor/deepmerge",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "workbox-window": "7.4.1"
  },
  "overrides": {
    "deepmerge": "$deepmerge",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
